{
  "schemaVersion": 1,
  "id": "craftcode",
  "provides": ["t3-mc", "t3mc"],
  "version": "${version}",
  "name": "CraftCode",
  "authors": ["karilaa-dev"],
  "license": "MIT",
  "contact": {
    "homepage": "https://modrinth.com/mod/craftcode",
    "sources": "https://github.com/karilaa-dev/CraftCode",
    "issues": "https://github.com/karilaa-dev/CraftCode/issues"
  },
  "icon": "assets/craftcode/icon.png",
  "description": "CraftCode is an unofficial Minecraft client for T3 Code. Chat with coding agents, share images, and answer questions in-game.\nModrinth: https://modrinth.com/mod/craftcode\nGitHub: https://github.com/karilaa-dev/CraftCode",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.craftcode.CraftCodeClient"]
  },
  "jars": [
    { "file": "META-INF/jars/spruceui-${spruceUiVersion}.jar" }
  ],
  "depends": {
    "minecraft": "26.3",
    "java": ">=25",
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "spruceui": ">=12.0.0"
  }
}
