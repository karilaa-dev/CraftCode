{
  "schemaVersion": 1,
  "id": "t3-mc",
  "provides": ["t3mc"],
  "version": "${version}",
  "name": "t3-mc",
  "authors": ["karilaa-dev"],
  "license": "MIT",
  "contact": {
    "homepage": "https://modrinth.com/mod/t3-mc",
    "sources": "https://github.com/karilaa-dev/t3-mc",
    "issues": "https://github.com/karilaa-dev/t3-mc/issues"
  },
  "icon": "assets/t3mc/icon.png",
  "description": "An unofficial client for chatting with T3 Code agents and receiving updates in Minecraft. By karilaa-dev.\nModrinth: https://modrinth.com/mod/t3-mc\nGitHub: https://github.com/karilaa-dev/t3-mc",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.t3mc.T3McClient"]
  },
  "jars": [
    { "file": "META-INF/jars/spruceui-${spruceUiVersion}.jar" }
  ],
  "depends": {
    "minecraft": "26.3",
    "java": ">=25",
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "spruceui": ">=12.0.0"
  }
}
